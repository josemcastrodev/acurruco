---
import ToolPage from "../../components/ToolPage.astro";
import { byHref } from "../../data/herramientas";
import { precios, tramos, panalesPrimerAno, miles } from "../../data/panales-precios";
const t = byHref("/herramientas/calculadora-de-panales/");
const hoy = new Date().toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---
<ToolPage tool={t}>
  <form class="panel panel--ink calc" id="calc">
    <div class="calc__top">
      <label class="f f--range" for="edad">Edad del bebé <output class="f__val" id="edad-out" for="edad">1 mes</output>
        <input type="range" id="edad" name="edad" min="0" max="24" step="1" value="1" />
      </label>
    </div>
    <div class="facts nums">
      <div><strong id="c-dia">8</strong><span>pañales al día</span></div>
      <div><strong id="c-mes">240</strong><span>al mes</span></div>
      <div><strong id="c-talla">1</strong><span>talla aproximada</span></div>
      <div><strong id="c-ano">{miles(Math.round(panalesPrimerAno / 100) * 100)}</strong><span>el primer año</span></div>
    </div>
    <ol class="bars" role="list" id="bars"></ol>
    <p class="muted small" id="ahorro"></p>
    <p class="muted small">Precio por pañal en carrefour.es el {hoy} (mediana de los paquetes en stock de cada talla); Deliplus según Mercadona. Es una estimación: cada bebé es un mundo.</p>
  </form>
</ToolPage>
<style is:global>
  .calc__top { display: grid; }
  .calc .f { color: var(--field-ink); font-size: var(--step-body); }
  .calc .f__val { color: var(--accent); }
  .calc input[type=range] { accent-color: var(--accent); }
  .bars { display: grid; gap: 8px; }
  .bars .bar { display: grid; grid-template-columns: minmax(9rem, 14rem) 1fr auto; gap: 1rem; align-items: center; }
  .bars .bar a, .bars .bar > span:first-child { color: var(--field-ink); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.18em; font-weight: 600; font-size: var(--step-small); }
  .bars .bar__track { height: 1.1rem; background: rgba(255,255,255,0.1); border-radius: 6px; overflow: hidden; }
  .bars .bar__fill { height: 100%; background: var(--field-muted); border-radius: 6px; transition: width 400ms var(--ease-out); }
  .bars .bar--best .bar__fill { background: var(--accent); }
  .bars .bar strong { font-family: var(--font-display); font-variation-settings: "SOFT" 100, "opsz" 36; font-size: 1.2rem; white-space: nowrap; }
  @media (max-width: 640px) { .bars .bar { grid-template-columns: 1fr auto; } .bars .bar__track { grid-column: 1 / -1; } }
</style>
<script define:vars={{ precios, tramos }}>
  const range = document.getElementById("edad"), out = document.getElementById("edad-out"), bars = document.getElementById("bars"), ahorro = document.getElementById("ahorro");
  const $ = (id) => document.getElementById(id);
  const eur = (n) => Math.round(n).toLocaleString("es-ES") + " €";
  const paint = () => {
    const m = Number(range.value);
    const t = tramos.find((x) => m <= x.hasta) ?? tramos[tramos.length - 1];
    const mes = Math.round(t.dia * 30);
    out.textContent = m === 0 ? "recién nacido" : m === 1 ? "1 mes" : `${m} meses`;
    $("c-dia").textContent = String(t.dia).replace(".", ","); $("c-mes").textContent = String(mes); $("c-talla").textContent = String(t.talla);
    const rows = precios.map((b) => ({ ...b, u: b.precio[t.talla - 1] })).filter((b) => b.u).map((b) => ({ ...b, coste: mes * b.u })).sort((a, b) => a.coste - b.coste);
    const max = rows[rows.length - 1].coste;
    bars.replaceChildren(...rows.map((r, i) => {
      const li = document.createElement("li"); li.className = "bar" + (i === 0 ? " bar--best" : "");
      const a = document.createElement(r.href ? "a" : "span"); if (r.href) a.href = r.href; a.textContent = r.name;
      const track = document.createElement("div"); track.className = "bar__track";
      const fill = document.createElement("div"); fill.className = "bar__fill"; fill.style.width = Math.round((r.coste / max) * 100) + "%"; track.append(fill);
      const st = document.createElement("strong"); st.className = "nums"; st.textContent = eur(r.coste) + "/mes";
      li.append(a, track, st); return li;
    }));
    const d = (rows[rows.length - 1].coste - rows[0].coste) * 12;
    ahorro.textContent = `Entre ${rows[0].name} y ${rows[rows.length - 1].name} hay ${eur(d)} al año, a los mismos ${mes} pañales al mes.`;
  };
  range.addEventListener("input", paint); paint();
</script>
