---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { edades } from "../../data/regalos-guia";
const photos: Record<string, string> = { "recien-nacido": "/img/photos/regalo-rn-43.jpg", "3-6-meses": "/img/photos/regalo-3-6-43.jpg", "6-12-meses": "/img/photos/regalo-6-12-43.jpg", "1-ano": "/img/photos/regalo-1-2-43.jpg", navidad: "/img/photos/navidad-43.jpg" };
/* La regla de edades: cada tramo ocupa su parte de los 24 meses. */
const tramos = [
  { slug: "recien-nacido", from: 0, to: 3, label: "0–3 meses", short: "Recién nacido" },
  { slug: "3-6-meses", from: 3, to: 6, label: "3–6 meses", short: "Ya agarra" },
  { slug: "6-12-meses", from: 6, to: 12, label: "6–12 meses", short: "Se sienta" },
  { slug: "1-ano", from: 12, to: 24, label: "1–2 años", short: "Anda" },
];
const byAge = (slug: string) => edades.find((e) => e.slug === slug)!;
const navidad = byAge("navidad");
---
<Base title="Qué regalar a un bebé, por edad y presupuesto · Acurruco" description="Ideas de regalo para bebés de 0 a 2 años, por edad y presupuesto, con lo que se usa de verdad y lo que acaba en un armario. Con precios de hoy y una guía especial de Navidad." canonical="https://acurruco.com/regalos/">
  <Header />
  <main class="rg">
    <header class="rg__hero">
      <div class="rg__hero-in wrap">
        <div class="rg__text">
          <h1 class="head">Qué regalar a un bebé</h1>
          <p class="lead">Depende de la edad mucho más que del presupuesto: a los dos meses no juega, a los ocho se lo lleva todo a la boca y al año quiere hacer lo que haces tú. Elige el tramo en la regla.</p>
        </div>
        <figure class="rg__photo"><img src="/img/photos/regalos-43.jpg" alt="Regalos para un bebé envueltos en papel kraft junto a un sonajero de madera" width="960" height="720" fetchpriority="high" /></figure>
      </div>
    </header>

    <section class="wrap ruler-s" aria-label="Por edad">
      <ol class="ruler" role="list">
        {tramos.map((t) => {
          const e = byAge(t.slug);
          return (
            <li class="ruler__seg" style={`--span: ${t.to - t.from}`}>
              <a class="ruler__a" href={`/regalos/${t.slug}/`}>
                <span class="ruler__ticks" aria-hidden="true">{Array.from({ length: t.to - t.from }, (_, i) => <i class:list={[{ big: (t.from + i) % 6 === 0 }]} />)}</span>
                <span class="ruler__label nums">{t.label}</span>
                <strong class="ruler__h">{t.short}</strong>
                <span class="ruler__t">{e.bullets[0]}</span>
                <img src={photos[t.slug]} alt="" width="960" height="720" loading="lazy" />
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="wrap xmas" aria-labelledby="xmas-title">
      <a class="xmas__card" href="/regalos/navidad/">
        <div class="xmas__text">
          <p class="xmas__kicker">Esta Navidad</p>
          <h2 id="xmas-title" class="head">{navidad.h}</h2>
          <p>{navidad.intro}</p>
          <span class="xmas__go">Ver la guía de Navidad</span>
        </div>
        <figure class="xmas__photo"><img src="/img/photos/navidad-43.jpg" alt="" width="960" height="720" loading="lazy" /></figure>
      </a>
    </section>

    <section class="wrap budget" aria-labelledby="budget-title">
      <h2 id="budget-title" class="head">Si vas por presupuesto</h2>
      <div class="budget__grid">
        <div><strong class="nums">Hasta 25 €</strong><p>Mordedores de caucho, sonajeros de madera, libros de tela y cartón, muselinas. Lo que más se usa, cueste lo que cueste.</p></div>
        <div><strong class="nums">De 25 a 60 €</strong><p>Gimnasio de actividades, saco de dormir, proyector de nanas, bloques de madera, correpasillos.</p></div>
        <div><strong class="nums">Más de 60 €</strong><p>Para regalar entre varios: portabebés, vigilabebés, hamaca, trona, triciclo evolutivo.</p></div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .rg { display: grid; gap: 3rem; }
  .rg__hero { background: #fff; }
  .rg__hero-in { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 3rem; align-items: center; padding-block: 1.5rem; }
  .rg__text { display: grid; gap: 1rem; max-width: 60ch; }
  .rg__photo { margin: 0; border-radius: 14px; overflow: hidden; aspect-ratio: 4 / 3; max-height: 340px; }
  .rg__photo img { width: 100%; height: 100%; object-fit: cover; }
  /* la regla */
  .ruler { display: grid; grid-template-columns: 3fr 3fr 6fr 12fr; gap: 10px; }
  .ruler__a { display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 0.35rem; height: 100%; text-decoration: none; color: inherit; background: #fff; border-radius: 14px; padding: 1rem 1.1rem 0; overflow: hidden; transition: transform var(--t-ui) var(--ease-out); }
  .ruler__ticks { display: flex; justify-content: space-between; align-items: flex-end; height: 18px; border-bottom: 2px solid var(--ink); margin-bottom: 0.3rem; }
  .ruler__ticks i { display: block; width: 2px; height: 8px; background: var(--ink); }
  .ruler__ticks i.big { height: 16px; background: var(--accent); width: 3px; }
  .ruler__label { font-size: var(--step-small); color: var(--muted); font-weight: 600; }
  .ruler__h { font-family: var(--font-display); font-variation-settings: "SOFT" 100, "opsz" 36; font-size: clamp(1.3rem, 1rem + 1vw, 1.8rem); font-weight: 600; line-height: 1.1; }
  .ruler__t { font-size: var(--step-small); color: var(--muted); }
  .ruler__a img { width: calc(100% + 2.2rem); margin: 0.75rem -1.1rem 0; aspect-ratio: 3 / 2; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) { .ruler__a:hover { transform: translateY(-4px); } }
  @media (max-width: 900px) { .ruler { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ruler { grid-template-columns: 1fr; } }
  /* navidad */
  .xmas__card { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 2rem; align-items: center; background: var(--field); color: var(--field-ink); border-radius: 18px; overflow: hidden; text-decoration: none; }
  .xmas__text { display: grid; gap: 0.8rem; padding: 2.25rem 0 2.25rem 2.5rem; max-width: 60ch; }
  .xmas__text p { color: var(--field-muted); }
  .xmas__kicker { font-weight: 700; color: var(--accent); }
  .xmas__go { font-weight: 700; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .xmas__photo { margin: 0; height: 100%; min-height: 240px; }
  .xmas__photo img { width: 100%; height: 100%; object-fit: cover; }
  /* presupuesto */
  .budget { display: grid; gap: 1.25rem; }
  .budget__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .budget__grid div { display: grid; gap: 0.4rem; padding: 1.25rem 1.4rem; background: #fff; border-radius: 14px; }
  .budget__grid strong { font-family: var(--font-display); font-variation-settings: "SOFT" 100, "opsz" 36; font-size: 1.5rem; font-weight: 600; }
  .budget__grid p { font-size: var(--step-small); color: var(--muted); }
  @media (max-width: 820px) { .rg__hero-in { grid-template-columns: 1fr; } .rg__photo { max-height: 220px; aspect-ratio: 2 / 1; } .xmas__card { grid-template-columns: 1fr; } .xmas__text { padding: 1.5rem; } .budget__grid { grid-template-columns: 1fr; } }
</style>
