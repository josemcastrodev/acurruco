---
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import ProductArt from "../../../components/ProductArt.astro";
import AmazonCard from "../../../components/AmazonCard.astro";
import { amazonOnly, amazonLink, kindLabel, mentions } from "../../../data/amazon-products";

export function getStaticPaths() {
  const items = amazonOnly();
  return items.map((a) => {
    const m = mentions(a.asin);
    const where = new Set(m.map((x) => x.href));
    const related = items.filter((b) => b.asin !== a.asin && mentions(b.asin).some((x) => where.has(x.href))).slice(0, 4);
    return { params: { asin: a.asin }, props: { a, m, related } };
  });
}
const { a, m, related } = Astro.props;
const tipo = kindLabel[a.kind] ?? "Juguete";
const first = m[0];
const crumb = first ? (first.href.startsWith("/regalos/") ? ["Regalos", "/regalos/"] : first.href.startsWith("/guias/") ? ["Guías", "/guias/"] : ["Comparativas", "/comparativas/"]) : ["Inicio", "/"];
const cut = (s: string, n: number) => (s.length <= n ? s : s.slice(0, n).replace(/\s+\S*$/, "") + "…");
const description = cut(`${a.name}${a.brand && !a.name.toLowerCase().includes(a.brand.toLowerCase()) ? ` de ${a.brand}` : ""}: ${first ? first.why.replace(/[.:]?$/, ".") : ""} Para qué sirve, para qué edad y enlace para ver el precio en Amazon.`, 158);
const pageUrl = `https://acurruco.com/p/a/${a.asin}/`;
const isBook = /^\d{9}[\dX]$/.test(a.asin);
---
<Base title={`${a.name} · Acurruco`} description={description} canonical={pageUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: "https://acurruco.com/" },
        { "@type": "ListItem", position: 2, name: crumb[0], item: `https://acurruco.com${crumb[1]}` },
        { "@type": "ListItem", position: 3, name: a.name },
      ],
    })} />
  </Fragment>
  <Header />
  <main class="wrap prod">
    <nav class="crumbs small" aria-label="Estás en"><a href="/">Inicio</a> › <a href={crumb[1]}>{crumb[0]}</a>{first && <> › <a href={first.href}>{first.label}</a></>}</nav>
    <article class="prod__main">
      <figure class="prod__img">
        <span class="prod__frame"><ProductArt kind={a.kind} plain label={`Dibujo: ${tipo.toLowerCase()}`} /></span>
        <figcaption class="small muted">Es un dibujo, no la foto del producto. Las fotos están en Amazon.</figcaption>
      </figure>
      <div class="prod__info">
        <p class="prod__brand">{a.brand ? `${a.brand} · ` : ""}{tipo}</p>
        <h1 class="prod__name">{a.name}</h1>
        <div class="offer offer--best">
          <span class="offer__store">Amazon</span>
          <span class="offer__price offer__price--na">Precio al abrir</span>
          <span class="offer__stock">El precio de hoy y el envío los ves en su página.</span>
          <a class="button" href={amazonLink(a.asin)} rel="sponsored nofollow noopener" target="_blank">Ver precio en Amazon</a>
        </div>
        <p class="small muted">Si compras desde este enlace nos llevamos una comisión y a ti no te cuesta más.</p>
        <dl class="specs">
          {a.brand && <div><dt>{isBook ? "Editorial" : "Marca"}</dt><dd>{a.brand}</dd></div>}
          <div><dt>Tipo</dt><dd>{tipo}</dd></div>
          <div><dt>{isBook ? "ISBN" : "ASIN"}</dt><dd class="nums">{a.asin}</dd></div>
        </dl>
      </div>
    </article>
    {m.length > 0 && (
      <section class="why" aria-labelledby="why-title">
        <h2 id="why-title" class="head">Por qué lo recomendamos</h2>
        <ul role="list">
          {m.map((x) => <li><p>{x.why}</p><a class="link-plain small" href={x.href}>{x.label}</a></li>)}
        </ul>
      </section>
    )}
    {related.length > 0 && (
      <section class="related" aria-labelledby="rel-title">
        <h2 id="rel-title" class="head">En la misma lista</h2>
        <div class="related__grid">{related.map((r) => <AmazonCard asin={r.asin} />)}</div>
      </section>
    )}
  </main>
  <Footer />
</Base>
<style>
  .prod { padding-block: 1.5rem 0; display: grid; gap: 3rem; }
  .crumbs a { text-decoration: none; }
  .prod__main { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); align-items: start; }
  .prod__img { margin: 0; display: grid; gap: 0.5rem; }
  .prod__frame { display: grid; place-items: center; background: #fff; border-radius: 14px; aspect-ratio: 1; padding: 16%; }
  .prod__info { display: grid; gap: 1.25rem; }
  .prod__brand { font-weight: 600; color: var(--muted); font-size: var(--step-small); text-transform: uppercase; letter-spacing: 0.04em; }
  .prod__name { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem); line-height: 1.1; }
  .offer { display: grid; gap: 0.35rem; padding: 1.25rem 1.5rem; background: #fff; border-radius: 12px; justify-items: start; }
  .offer--best { outline: 3px solid var(--accent); }
  .offer__store { font-weight: 700; }
  .offer__price { font-family: var(--font-display); font-variation-settings: "SOFT" 100, "opsz" 72; font-size: 1.2rem; font-weight: 600; color: var(--muted); }
  .offer__stock { font-size: var(--step-small); color: var(--muted); }
  .offer .button { margin-top: 0.5rem; }
  .specs { display: grid; gap: 0.5rem; font-size: var(--step-small); }
  .specs div { display: grid; grid-template-columns: 7rem 1fr; }
  .specs dt { color: var(--muted); }
  .why { display: grid; gap: 1rem; max-width: 72ch; }
  .why ul { display: grid; gap: 8px; }
  .why li { background: #fff; border-radius: 12px; padding: 1.1rem 1.4rem; display: grid; gap: 0.3rem; }
  .related__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-top: 1.5rem; }
  @media (max-width: 760px) { .prod__main { grid-template-columns: 1fr; } }
</style>
