---
import ToolPage from "../components/ToolPage.astro";
import { byHref } from "../data/herramientas";
import { lista, type Item } from "../data/lista";
const t = byHref("/lista-de-nacimiento/");

/* Precio orientativo de cada cosa (nivel medio) y productos concretos del catálogo para "ver opciones". */
const all = import.meta.glob("../data/catalog/*.json", { eager: true });
const byId = new Map<string, any>();
for (const k in all) if (!k.endsWith("index.json")) for (const p of (all[k] as any).default) byId.set(p.id, p);
const items = lista.flatMap((b, bi) => b.items.map((it, ii) => ({ ...it, id: `${bi}-${ii}`, bloque: b.name, picks: (it.ids || []).map((id) => byId.get(id)).filter((p) => p && p.stock).slice(0, 2) })));
const total = items.length, must = items.filter((i) => i.must).length;
const eur = (n: number) => n.toLocaleString("es-ES", { maximumFractionDigits: 0 }) + " €";
const sumMust = items.filter((i) => i.must).reduce((n, i) => n + i.price, 0), sumAll = items.reduce((n, i) => n + i.price, 0);
---
<ToolPage tool={{ ...t, lead: `${total} cosas: ${must} imprescindibles antes de nacer y el resto pueden esperar. Marca lo que ya tienes y lo que te regalan, mira cuánto falta y compártela con un enlace.` }}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "ItemList", name: "Lista de nacimiento", numberOfItems: total, itemListElement: items.map((i, n) => ({ "@type": "ListItem", position: n + 1, name: i.name })) })} />
  </Fragment>
  <div class="lst" id="lista" data-total={total}>
    <div class="lst__top panel panel--ink">
      <div class="lst__sum">
        <div class="big"><strong class="nums" id="l-falta">{eur(sumMust)}</strong><span id="l-falta-t">por comprar de lo imprescindible</span></div>
        <div class="facts nums">
          <div><strong id="l-tengo">0</strong><span>ya lo tengo</span></div>
          <div><strong id="l-regalo">0</strong><span>me lo regalan</span></div>
          <div><strong id="l-pend">{must}</strong><span>faltan de los {must} imprescindibles</span></div>
          <div><strong id="l-pend-all">{total}</strong><span>faltan de las {total} cosas</span></div>
        </div>
      </div>
      <div class="lst__ctrl">
        <div class="seg" role="group" aria-label="Qué ver">
          <label><input type="radio" name="ver" value="todo" checked /><span>Todo</span></label>
          <label><input type="radio" name="ver" value="must" /><span>Solo imprescindibles</span></label>
          <label><input type="radio" name="ver" value="falta" /><span>Solo lo que falta</span></label>
        </div>
        <div class="seg" role="group" aria-label="Estación en que nace">
          <label><input type="radio" name="est" value="invierno" checked /><span>Nace en invierno</span></label>
          <label><input type="radio" name="est" value="verano" /><span>En verano</span></label>
        </div>
        <div class="actions">
          <button class="button button--sm" type="button" id="share">Compartir la lista</button>
          <button class="button button--sm button--ghost" type="button" id="print">Imprimir</button>
          <button class="link-plain small" type="button" id="clear">Empezar de cero</button>
        </div>
      </div>
      <p class="muted small lst__hint">Toca cada cosa para pasarla de <em>falta</em> a <em>lo tengo</em> o <em>me lo regalan</em>. El enlace de arriba se actualiza solo: mándaselo a quien quiera regalar y verá lo que queda, con los productos.</p>
    </div>

    {lista.map((b, bi) => (
      <section class="blk" aria-labelledby={`b-${bi}`} data-bloque>
        <h2 id={`b-${bi}`} class="blk__name">{b.name} <span class="muted nums small" data-count></span></h2>
        <ol class="blk__items" role="list">
          {b.items.map((it: Item, ii) => {
            const item = items.find((x) => x.id === `${bi}-${ii}`)!;
            return (
              <li class:list={["it", { "it--opt": !it.must }]} data-id={item.id} data-must={it.must ? "1" : "0"} data-price={it.price} data-season={it.season || ""}>
                <div class="it__row">
                  <div class="it__state" role="group" aria-label={`Estado de ${it.name}`}>
                    <button type="button" class="st" data-st="1" aria-pressed="false" title="Ya lo tengo">Lo tengo</button>
                    <button type="button" class="st" data-st="2" aria-pressed="false" title="Me lo regalan">Me lo regalan</button>
                  </div>
                  <div class="it__body">
                    <strong class="it__name">{it.name}</strong>
                    <span class="it__price nums muted small">{it.price ? `unos ${eur(it.price)}` : ""}{!it.must && <em> · puede esperar</em>}</span>
                    <p class="it__why small muted">{it.why}</p>
                  </div>
                  <a class="it__go link-plain small" href={it.href}>Ver opciones</a>
                </div>
                {item.picks.length > 0 && (
                  <ol class="it__picks picks" role="list">
                    {item.picks.map((p: any) => (
                      <li><a class="pick" href={`/p/${p.id}/`}><img src={p.img} alt="" width="64" height="64" loading="lazy" /><span><strong>{p.name.length > 48 ? p.name.slice(0, 46) + "…" : p.name}</strong><em class="nums">{p.price.toLocaleString("es-ES", { minimumFractionDigits: 2 })} € en Carrefour</em></span></a></li>
                    ))}
                  </ol>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <section class="panel lst__foot">
      <h2>Lo que no está en la lista, a propósito</h2>
      <p>Calientabiberones, esterilizador UV, cuna de viaje, trona, andador, zapatos, juguetes con pilas, peluches grandes y más de diez conjuntos de ropa de talla 0. Todo eso o no hace falta nunca o no hace falta todavía. Lo que sí se agradece y nadie pone en la lista: comida hecha para los padres las primeras semanas.</p>
      <p class="small muted">Precios orientativos del catálogo en noviembre de 2026, nivel medio. En total, lo imprescindible ronda {eur(sumMust)} y la lista completa {eur(sumAll)}; lo que te regalen, resta.</p>
    </section>
  </div>
</ToolPage>
<style is:global>
  .lst { display: grid; gap: 2rem; }
  .lst__top { gap: 1.25rem; }
  .lst__sum { display: grid; grid-template-columns: minmax(14rem, 1fr) 2fr; gap: 1rem; align-items: stretch; }
  .lst__ctrl { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; }
  .panel--ink .seg { background: rgba(255,255,255,0.08); }
  .panel--ink .seg input:checked + span { background: var(--accent); color: var(--accent-ink); }
  .panel--ink .button--ghost { background: rgba(255,255,255,0.12); color: var(--field-ink); }
  .panel--ink .link-plain { color: var(--field-muted); }
  .lst__hint { max-width: 70ch; } .lst__hint em { font-style: normal; color: var(--field-ink); font-weight: 600; }
  .blk { display: grid; gap: 0.9rem; }
  .blk__name { font-size: var(--step-lead); }
  .blk__items { display: grid; gap: 8px; }
  .it { background: #fff; border-radius: 12px; padding: 0.9rem 1.1rem; display: grid; gap: 0.75rem; }
  .it--opt { background: color-mix(in oklab, #fff 60%, var(--bg)); }
  .it__row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1rem; align-items: start; }
  .it__state { display: grid; gap: 4px; }
  .st { padding: 0.35rem 0.7rem; border-radius: 8px; background: var(--bg); font-size: 0.8rem; font-weight: 600; white-space: nowrap; border: 1.5px solid transparent; }
  .st[aria-pressed=true] { background: var(--ink); color: var(--field-ink); }
  .it[data-state="2"] .st[data-st="2"] { background: var(--accent); color: var(--accent-ink); }
  .it__body { display: grid; gap: 0.15rem; min-width: 0; }
  .it__name { font-weight: 600; }
  .it[data-state="1"] .it__name, .it[data-state="2"] .it__name { text-decoration: line-through; color: var(--muted); }
  .it__price em { font-style: normal; }
  .it__why { max-width: 70ch; }
  .it__go { white-space: nowrap; font-weight: 600; }
  .it__picks { padding-left: 0; }
  .it[data-state="1"] .it__picks, .it[data-state="2"] .it__picks { display: none; }
  .it[hidden] { display: none; }
  .lst__foot { gap: 0.6rem; max-width: 80ch; }
  .lst__foot h2 { font-size: var(--step-lead); }
  @media (max-width: 700px) { .lst__sum { grid-template-columns: 1fr; } .it__row { grid-template-columns: 1fr; } .it__state { grid-template-columns: 1fr 1fr; order: 2; } .it__go { order: 3; } }
  @media print { .lst__top, .it__picks, .st, .it__go { display: none !important; } .it { break-inside: avoid; padding: 0.3rem 0; border-bottom: 1px solid #ddd; border-radius: 0; } .it[data-state="1"], .it[data-state="2"] { display: none; } }
</style>
<script>
  import { loadState, saveState, clearState, wireShare, eur } from "../scripts/state";
  const root = document.getElementById("lista")!;
  const items = [...root.querySelectorAll<HTMLElement>(".it")];
  type S = Record<string, number>; // id → 0 falta, 1 lo tengo, 2 me lo regalan
  let state = loadState<S & { _est?: string }>("lista", {}).value || {};
  if (Array.isArray(state)) { const s: S = {}; (state as string[]).forEach((id) => (s[id] = 1)); state = s; } // formato antiguo
  const $ = (id: string) => document.getElementById(id)!;
  const ver = () => (root.querySelector<HTMLInputElement>("input[name=ver]:checked")?.value || "todo");
  const est = () => (root.querySelector<HTMLInputElement>("input[name=est]:checked")?.value || "invierno");
  const paint = () => {
    let tengo = 0, regalo = 0, pendM = 0, pendA = 0, falta = 0, faltaAll = 0;
    const v = ver(), e = est();
    for (const el of items) {
      const id = el.dataset.id!, st = state[id] || 0, must = el.dataset.must === "1", price = Number(el.dataset.price) || 0, season = el.dataset.season;
      el.dataset.state = String(st);
      el.querySelectorAll<HTMLButtonElement>(".st").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.st) === st)));
      const offSeason = season && season !== e;
      const hide = offSeason || (v === "must" && !must) || (v === "falta" && st > 0);
      el.hidden = !!hide;
      if (offSeason) continue;
      if (st === 1) tengo++; else if (st === 2) regalo++; else { pendA++; faltaAll += price; if (must) { pendM++; falta += price; } }
    }
    $("l-tengo").textContent = String(tengo); $("l-regalo").textContent = String(regalo); $("l-pend").textContent = String(pendM); $("l-pend-all").textContent = String(pendA);
    $("l-falta").textContent = eur(falta); $("l-falta-t").textContent = pendM ? `por comprar de lo imprescindible · ${eur(faltaAll)} con todo` : `lo imprescindible está cubierto · ${eur(faltaAll)} con todo`;
    root.querySelectorAll<HTMLElement>("[data-bloque]").forEach((b) => { const vis = [...b.querySelectorAll<HTMLElement>(".it")].filter((x) => !x.hidden); const done = vis.filter((x) => Number(x.dataset.state) > 0).length; b.querySelector("[data-count]")!.textContent = vis.length ? `${done} de ${vis.length}` : ""; b.hidden = vis.length === 0; });
  };
  const save = () => { const { _est, ...rest } = state as any; saveState("lista", { ...rest, _est: est() === "verano" ? "v" : undefined }); };
  root.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>(".st"); if (!b) return;
    const el = b.closest<HTMLElement>(".it")!, id = el.dataset.id!, st = Number(b.dataset.st);
    state[id] = state[id] === st ? 0 : st; if (!state[id]) delete state[id];
    save(); paint();
  });
  root.querySelectorAll<HTMLInputElement>("input[name=ver], input[name=est]").forEach((r) => r.addEventListener("change", () => { save(); paint(); }));
  if ((state as any)._est === "v") { const r = root.querySelector<HTMLInputElement>("input[name=est][value=verano]"); if (r) r.checked = true; }
  delete (state as any)._est;
  $("clear").addEventListener("click", () => { state = {}; clearState("lista"); paint(); });
  $("print").addEventListener("click", () => window.print());
  wireShare($("share"), "Mi lista de nacimiento · Acurruco");
  paint();
</script>
