const body = art[kind] ?? art.regalo;
---
<svg class:list={["art", cls]} viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} focusable="false">
  {!plain && <rect width="200" height="200" fill="#f3eef2" />}
  <Fragment set:html={body} />
</svg>
<style>
  .art { display: block; width: 100%; height: 100%; }
</style>
