---
/* Ilustración del tipo de producto, para cuando no tenemos foto propia (Amazon no deja usar sus fotos sin su API).
   Las ilustraciones están en public/img/illus/<kind>.webp; se generaron en ChatGPT con un estilo único y se recortaron de cuadrículas 2×2. */
interface Props { kind?: string; class?: string; label?: string; plain?: boolean }
const { kind = "regalo", class: cls, label } = Astro.props;
const known = new Set(["silla", "cuna", "panal", "crema", "mordedor", "sonajero", "pelota", "muselina", "libro-tela", "sensorial", "aros", "bloques", "libro-bano", "libro", "puzzle", "xilofono", "piano", "regalo", "saco", "chupete"]);
const k = known.has(kind) ? kind : "regalo";
---
<img class:list={["art", cls]} src={`/img/illus/${k}.webp`} alt={label ?? ""} width="600" height="600" loading="lazy" decoding="async" />
<style>
  .art { display: block; width: 100%; height: 100%; object-fit: contain; background: #fbf7f3; }
</style>
